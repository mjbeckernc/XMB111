751  +%macro CAR_Binary_File_Copy(
752  +  infile=_bcin
753  +  , outfile=_bcout
754  +  , returnName=_bcrc
755  +  , chunkSize=16392
756  +);
757  +
758  +  %local
759  +    startTime
760  +    endTime
761  +    diffTime
762  +  ;
763  +
764  +  %let startTime = %sysfunc( datetime() );
765  +
766  +  %if %sysevalf( &chunkSize > 32767 ) = 1 %then %do;
767  +    %put NOTE: &sysMacroname chunksize > 32767, setting it to 32767;
768  +    %let chunksize = 32767;
769  +  %end;
770  +
771  +  %put NOTE: &sysMacroname start %sysfunc( putn(&startTime, datetime19.));
772  +  %put NOTE: &sysMAcroname infile=&infile %qsysfunc(pathname(&infile));
773  +  %put NOTE: &sysMAcroname outfile=&outfile %qsysfunc(pathname(&outfile));
774  +
16                                                         The SAS System                    Thursday, November 20, 2025 05:01:00 PM

775  +  *
776  +  * create global return var
777  +  *;
778  +  %if %symexist(&returnName) = 0 %then %do;
779  +    %global &returnName;
780  +  %end;
781  +
782  +  data _null_;
783  +    length
784  +      msg $ 1024
785  +      rec $ &chunkSize
786  +      outfmt $ 32
787  +    ;
788  +
789  +    *
790  +    * open input and output file with binary mode
791  +    *;
792  +    fid_in = fopen("&infile", 'S', &chunkSize, 'B');
793  +
794  +    *
795  +    * check for unsuccessful open
796  +    *;
797  +    if fid_in <= 0 then do;
798  +      msg = sysmsg();
799  +      putlog "ERROR: &sysMacroname open failed for &infile";
800  +      putlog msg;
801  +      call symputx("&returnName",8);
802  +      stop;
803  +    end;
804  +
805  +    fid_out = fopen("&outfile", 'O', &chunkSize, 'B');
806  +
807  +    *
808  +    * check for unsuccessful open
809  +    *;
810  +    if fid_out <= 0 then do;
811  +      msg = sysmsg();
812  +      putlog "ERROR: &sysMacroname open failed for &outfile";
813  +      putlog msg;
814  +      call symputx("&returnName",8);
815  +      stop;
816  +    end;
817  +
818  +    *
819  +    * we will keep track on the number of bytes processed
820  +    *;
821  +    bytesProcessed = 0;
822  +
823  +    *
824  +    * read loop on input file
825  +    *;
826  +    do while( fread(fid_in) = 0 );
827  +      call missing(outfmt, rec);
828  +      rcGet = fget(fid_in, rec, &chunkSize);
829  +
830  +      *
831  +      * need this information for write processing
832  +      *;
17                                                         The SAS System                    Thursday, November 20, 2025 05:01:00 PM

833  +      fcolIn = fcol(fid_in);
834  +
835  +      *
836  +      * need a format length to handle situations
837  +      * where last chars in rec are blank
838  +      * true: normal situation
839  +      * false: last chunk of data at end of file
840  +      *;
841  +      if (fColIn - &chunkSize) = 1 then do;
842  +        fmtLength = &chunkSize;
843  +      end;
844  +      else do;
845  +        fmtLength = fColIn - 1;
846  +      end;
847  +
848  +      *
849  +      * prepare the output format
850  +      * and write rec
851  +      *;
852  +      outfmt = cats("$char", fmtLength, ".");
853  +      rcPut = fput(fid_out, putc(rec, outfmt));
854  +      rcWrite = fwrite(fid_out);
855  +
856  +      *
857  +      * keep track of bytes
858  +      *;
859  +      bytesProcessed + fmtLength;
860  +
861  +      *
862  +      * just in case
863  +      *;
864  +      maxRc = max(rcGet, rcPut, rcWrite);
865  +      if maxRc > 0 then do;
866  +        putlog "ERROR: &sysMacroname checklog " rcGet= rcPut= rcWrite=;
867  +        call symputx("&returnName", 8);
868  +      end;
869  +    end;
870  +
871  +    putlog "NOTE: &sysMacroname processed " bytesProcessed "bytes";
872  +    rcInC = fclose(fid_in);
873  +    rcOutC = fclose(fid_out);
874  +    maxRc = max(rcInC, rcOutC);
875  +
876  +    if maxRc > 0 then do;
877  +      putlog "ERROR: &sysMacroname checklog " rcInC= rcOutC=;
878  +      call symputx("&returnName", 8);
879  +    end;
880  +    else do;
881  +      call symputx("&returnName", 0);
882  +    end;
883  +  run;
884  +
885  +  filename _bcin clear;
886  +
887  +  %let endTime = %sysfunc( datetime() );
888  +  %put NOTE: &sysMacroname end %sysfunc( putn(&endTime, datetime19.));
889  +  %let diffTime = %sysevalf( &endTime - &startTime );
890  +  %put NOTE: &sysMacroname processtime %sysfunc( putn(&diffTime, tod12.3));

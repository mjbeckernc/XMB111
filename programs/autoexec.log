1355 +%macro CAR_Unzip_Zip_File(infile=, toloc=);
1356 +
1357 +   %local isfolder folder_name;
1358 +   filename inzip ZIP "&infile";
1359 +
1360 +   /* Read the "members" (files) from the ZIP file */
1361 +   data contents(keep=memname isFolder);
1362 +      length memname $200 isFolder 8;
1363 +      fid=dopen("inzip");
1364 +      if fid=0 then
1365 +         stop;
1366 +      memcount=dnum(fid);
1367 +      do i=1 to memcount;
1368 +         memname=dread(fid,i);
1369 +         /* check for trailing / in folder name */
1370 +         isFolder = (first(reverse(trim(memname)))='/');
1371 +         output;
1372 +      end;
1373 +      rc=dclose(fid);
1374 +   run;
1375 +
1376 +   /* Retain Folder Name For Each Dataset */
1377 +   data contents;
1378 +      format foldername $200.;
1379 +      set contents;
1380 +      if isFolder=1 then foldername=memname;
1381 +      retain foldername;
1382 +   run;
1383 +
1384 +   /* Remove Folder Name For Each Dataset Name */
1385 +   data contents;
1386 +      set contents;
1387 +      if isFolder=0;
1388 +      memname=tranwrd(memname, left(trim(foldername)), "");
1389 +   run;
1390 +
1391 +   /* Copy a zipped data set into the WORK library */
1392 +   data _NULL_;
1393 +      set contents;
1394 +      call symputx("Nobs",_N_);
1395 +   run;
1396 +
1397 +   %do i=1 %to &Nobs;
1398 +
1399 +      data _NULL_;
1400 +         set contents;
1401 +         if _N_=&i;
1402 +            call symputx("foldername",foldername);
1403 +            call symputx("dsn_name",memname);
1404 +      run;
1405 +
1406 +      %put *** Now Copying &dsn_name in observation &i;
1407 +
1408 +    %if "&toloc."="" %then %do;
1409 +      filename ds "%sysfunc(getoption(work))/&dsn_name" ;
1410 +    %end;
1411 +    %else %do;
1412 +      filename ds "&toloc.&foldername.&dsn_name";
27                                                         The SAS System                    Thursday, November 20, 2025 05:01:00 PM

1413 +    %end;
1414 +      data _null_;
1415 +         /* reference the member name WITH folder path */
1416 +         infile inzip(&foldername.&dsn_name.)
1417 +           lrecl=256 recfm=F length=length eof=eof unbuf;
1418 +         file   ds lrecl=256 recfm=N;
1419 +         input;
1420 +         put _infile_ $varying256. length;
1421 +         return;
1422 +         eof:
1423 +         stop;
1424 +      run;
1425 +   %end;
1426 +%mend;

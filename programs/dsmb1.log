2514 +
2515 +%mfreq(mfdata=dm, mfout=gender, mfcntvar=sexn, mforder=2, mfdrng=%str(1,2), mffmt=sexf);
2516 +
2517 +%mfreq(mfdata=dm, mfout=race, mfcntvar=x_race, mforder=3, mffmt=racef);
2518 +
2519 +%mss(msdata=dm, msout=height, msvar=height, msstats=n meansd median range, msprec=0, msorder=4);
2520 +
2521 +%mss(msdata=dm, msout=weight, msvar=weight, msstats=n meansd median range, msprec=0, msorder=5);
2522 +
2523 +%mss(msdata=dm, msout=tbsa, msvar=tbsa, msstats=n meansd median range, msprec=1, msorder=6);
2524 +
2525 +data final;
2526 +  set age gender race height weight tbsa;
2527 +  length page 4;
2528 +  page=1;
2529 +run;
2530 +
2531 +proc sort data=final;
2532 +  by page order sorder;
2533 +run;
2534 +
2535 +data final;
2536 +  set final;
2537 +  by page order sorder;
2538 +  length firstcol $30;
2539 +  if first.order then firstcol=put(order,orderf.);
2540 +  else firstcol='';
2541 +  if order>3 then page=2;
2542 +run;

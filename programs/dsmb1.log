2741 +proc report data=final headline headskip nowindows split='|' missing spacing=1;
2742 +  column page aebodsys sorder &aevar ("Age Group (years) \brdrb\brdrs" trt1 trt2 trt3 trt4 trt5) trt6;
2743 +  define page /order noprint;

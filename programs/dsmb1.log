2756 +  define trt5 / "     3 - &up_limit Total |     (N=&pop5)|     n (%)" style={cellwidth=8%};
2757 +  define trt6 / "     Total |     (N=&pop6)|     n (%)" style={cellwidth=8%};
2758 +  break after page / page;
2759 +  compute before aebodsys;
2760 +    line " ";
2761 +  endcomp;

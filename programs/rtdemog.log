1580  
1581  %mfreq(mfdata=dm, mfout=race, mfcntvar=x_race, mforder=3, mffmt=racef);
1582  
1583  %mss(msdata=dm, msout=height, msvar=height, msstats=n meansd median range, msprec=0, msorder=4);
